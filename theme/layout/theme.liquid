<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">

    <title>
      {{- page_title -}}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% render 'meta-tags' %}

    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {{ 'cormorant-garamond-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}
    {{ 'inter-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: '' }}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    {%- liquid
      assign show_intro = false
      if settings.intro_enabled
        if request.page_type == 'index' or settings.intro_all_pages
          assign show_intro = true
        endif
      endif
    -%}
    {%- if show_intro -%}
      <script>
        (function () {
          try {
            var root = document.documentElement;
            var forced = /[?&]intro=1/.test(window.location.search);
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            if (!forced && window.sessionStorage.getItem('sutarwaty_intro_seen') === '1') return;
            root.classList.add('has-intro');
          } catch (e) { /* zonder opslag: geen intro */ }
        })();
      </script>
    {%- endif -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.animations %} has-animations{% endif %}">
    {%- if show_intro -%}
      <div class="intro" data-intro aria-hidden="true">
        <div class="intro__bg" data-intro-bg></div>
        <p class="intro__word" data-intro-word>
          {%- assign intro_letters = shop.name | upcase | split: '' -%}
          {%- for letter in intro_letters -%}<span class="intro__letter">{{ letter }}</span>{%- endfor -%}
        </p>
        <p class="intro__tagline" data-intro-tagline>{{ 'footer.tagline' | t }}</p>
      </div>
      <script src="{{ 'intro.js' | asset_url }}" defer></script>
    {%- endif -%}

    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
