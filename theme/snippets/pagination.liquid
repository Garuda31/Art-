{%- comment -%}
  Paginering. Parameters: paginate (het paginate-object)
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'pagination.label' | t }}">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li><a class="pagination__link" href="{{ paginate.previous.url }}" rel="prev">{{ 'pagination.previous' | t }}</a></li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__link">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li><a class="pagination__link" href="{{ paginate.next.url }}" rel="next">{{ 'pagination.next' | t }}</a></li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
