{%- comment -%}
  Nieuwsbriefformulier (Shopify-klantformulier).
  Parameters: id (uniek, verplicht)
{%- endcomment -%}
{%- form 'customer', class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="nieuwsbrief">
  <label class="visually-hidden" for="{{ id }}-email">{{ 'newsletter.email_label' | t }}</label>
  <div class="newsletter-form__row">
    <input
      type="email"
      id="{{ id }}-email"
      name="contact[email]"
      class="field"
      autocomplete="email"
      placeholder="{{ 'newsletter.email_placeholder' | t }}"
      required
    >
    <button type="submit" class="button">{{ 'newsletter.submit' | t }}</button>
  </div>
  {%- if form.posted_successfully? -%}
    <p class="newsletter-form__message" role="status">{{ 'newsletter.success' | t }}</p>
  {%- elsif form.errors -%}
    <p class="newsletter-form__message newsletter-form__message--error" role="alert">{{ form.errors | default_errors }}</p>
  {%- endif -%}
  <p class="newsletter-form__note small">{{ 'newsletter.privacy_note' | t }}</p>
{%- endform -%}
