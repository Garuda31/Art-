{%- comment -%}
  Subtotaal, verzendmelding, afrekenknop, betaalmethoden en vertrouwenspunten.
  Parameters: express (boolean) — toont Shop Pay / Apple Pay / PayPal-knoppen (alleen op de cartpagina)
{%- endcomment -%}
<div class="cart-summary">
  <p class="cart-summary__row">
    <span>{{ 'cart.subtotal' | t }}</span>
    <span class="cart-summary__total">{{ cart.total_price | money }}</span>
  </p>
  <p class="cart-summary__shipping">
    {% render 'icon', name: 'truck' %}
    <span>{{ 'cart.free_shipping' | t }}</span>
  </p>
  <p class="cart-summary__note small">{{ 'cart.shipping_note' | t }}</p>

  {%- form 'cart', cart, class: 'cart-summary__form' -%}
    <button type="submit" name="checkout" class="button button--full button--buy">
      {% render 'icon', name: 'lock' %}
      {{ 'cart.checkout' | t }}
    </button>
    {%- if express -%}
      {{ content_for_additional_checkout_buttons }}
    {%- endif -%}
  {%- endform -%}

  {%- if shop.enabled_payment_types.size > 0 -%}
    <ul class="cart-summary__payments" role="list" aria-label="{{ 'cart.payment_methods' | t }}">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <ul class="cart-summary__trust small" role="list">
    <li>{% render 'icon', name: 'return' %}{{ 'product.trust_return' | t }}</li>
    <li>{% render 'icon', name: 'certificate' %}{{ 'product.trust_certificate' | t }}</li>
    <li>{% render 'icon', name: 'lock' %}{{ 'cart.checkout_secure' | t }}</li>
  </ul>

  {%- if settings.whatsapp_number != blank or settings.contact_email != blank -%}
    <div class="cart-summary__help small">
      <p class="cart-summary__help-title">{{ 'cart.help' | t }}</p>
      <p class="muted">{{ 'cart.help_text' | t }}</p>
      <p class="cart-summary__help-links">
        {%- if settings.whatsapp_number != blank -%}
          <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ 'product.whatsapp' | t }}</a>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <a href="mailto:{{ settings.contact_email }}">{{ 'product.email' | t }}</a>
        {%- endif -%}
      </p>
    </div>
  {%- endif -%}
</div>
