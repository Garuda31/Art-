{%- comment -%}
  Structured data: Product + VisualArtwork met beschikbaarheid.
  Parameters: product, variant
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.artwork
  assign availability = 'https://schema.org/InStock'
  unless product.available
    assign availability = 'https://schema.org/OutOfStock'
  endunless
  if product.available and product.tags contains 'archief'
    assign availability = 'https://schema.org/Discontinued'
  endif
  assign description = mf.story.value | default: product.description | strip_html | strip_newlines | truncate: 500
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Product", "VisualArtwork"],
  "name": {{ product.title | json }},
  "url": {{ canonical_url | json }},
  {%- if description != blank %}
  "description": {{ description | json }},
  {%- endif %}
  {%- if product.images.size > 0 %}
  "image": [
    {%- for image in product.images limit: 6 -%}
      {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  {%- endif %}
  {%- if variant.sku != blank %}
  "sku": {{ variant.sku | json }},
  {%- endif %}
  {%- if mf.medium.value != blank %}
  "artMedium": {{ mf.medium.value | json }},
  {%- endif %}
  {%- if mf.year.value != blank %}
  "dateCreated": {{ mf.year.value | append: '' | json }},
  {%- endif %}
  "artform": "Painting",
  "creator": { "@type": "Person", "name": {{ shop.name | json }} },
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "price": {{ variant.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": {{ availability | json }},
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>
