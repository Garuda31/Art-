{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign button_link = section.settings.button_link
  if button_link == blank
    assign button_link = routes.all_products_url
  endif
  assign image_alt = 'about.image_alt' | t
-%}

<section class="about-page">
  {%- if section.settings.image -%}
    <div class="about-page__hero">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: image_alt,
          class: 'about-page__image'
      }}
    </div>
  {%- endif -%}

  <div class="section">
    <div class="container about-page__inner" data-reveal>
      <h1 class="about-page__title">{{ page.title }}</h1>
      <div class="rte about-page__text">
        {%- if page.content != blank -%}
          {{ page.content }}
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="container">
      <ul class="about-page__strip" role="list">
        {%- for block in section.blocks -%}
          <li data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '400, 600, 900',
                  sizes: '(min-width: 900px) 22vw, 50vw',
                  loading: 'lazy',
                  alt: image_alt
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'about-page__placeholder' }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="section about-page__cta">
    <div class="container">
      <a class="button" href="{{ button_link }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Over Sutarwaty",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Portret- of atelierbeeld", "info": "Breed beeld, bijvoorbeeld 2400 × 1200 px." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "info": "Wordt getoond als de pagina zelf (Online winkel → Pagina's) geen tekst heeft."
    },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "default": "Bekijk de collectie" },
    { "type": "url", "id": "button_link", "label": "Knoplink", "info": "Leeg laten voor alle werken." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Afbeelding",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Afbeelding" }]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Over Sutarwaty" }]
}
{% endschema %}
