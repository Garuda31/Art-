{{ 'sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'contact.js' | asset_url }}" defer></script>

<section class="section contact">
  <div class="container contact__grid">
    <div class="contact__form-wrap" data-reveal>
      <h1 class="contact__title">{{ page.title }}</h1>
      {%- if page.content != blank -%}
        <div class="rte contact__intro">{{ page.content }}</div>
      {%- endif -%}

      {%- form 'contact', class: 'contact__form', id: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="contact__message" role="status">{{ 'contact.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="contact__message contact__message--error" role="alert">
            <p>{{ 'contact.error_heading' | t }}</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="contact__row">
          <div class="contact__field">
            <label for="contact-name">{{ 'contact.name' | t }}</label>
            <input class="field" type="text" id="contact-name" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
          </div>
          <div class="contact__field">
            <label for="contact-email">{{ 'contact.email' | t }}</label>
            <input class="field" type="email" id="contact-email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
          </div>
        </div>
        <div class="contact__field">
          <label for="contact-subject">{{ 'contact.subject' | t }}</label>
          <input class="field" type="text" id="contact-subject" name="contact[{{ 'contact.subject_field' | t }}]" data-contact-subject>
        </div>
        <div class="contact__field">
          <label for="contact-body">{{ 'contact.message' | t }}</label>
          <textarea class="field" id="contact-body" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="button">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>

    <aside class="contact__details" data-reveal aria-labelledby="contact-details-heading">
      <h2 class="h3" id="contact-details-heading">{{ 'contact.details_heading' | t }}</h2>
      <ul class="contact__list" role="list">
        {%- if settings.contact_email != blank -%}
          <li>
            {% render 'icon', name: 'mail' %}
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          </li>
        {%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <li>
            {% render 'icon', name: 'whatsapp' %}
            <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{{ 'contact.whatsapp_label' | t }}</a>
          </li>
        {%- endif -%}
        {%- if settings.instagram_handle != blank -%}
          <li>
            {% render 'icon', name: 'instagram' %}
            <a href="https://www.instagram.com/{{ settings.instagram_handle }}" target="_blank" rel="noopener">@{{ settings.instagram_handle }}</a>
          </li>
        {%- endif -%}
      </ul>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": []
}
{% endschema %}
