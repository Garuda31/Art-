{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer></script>

<dialog
  class="cart-drawer"
  data-cart-drawer
  data-cart-url="{{ routes.cart_url }}"
  data-root="{{ routes.root_url }}"
  data-section-id="{{ section.id }}"
  {% if template.name == 'cart' %}data-cart-page{% endif %}
  aria-label="{{ 'cart.title' | t }}"
>
  <div class="cart-drawer__inner">
    <header class="cart-drawer__header">
      <h2 class="h3">{{ 'cart.title' | t }}</h2>
      <button type="button" class="icon-button" data-cart-close aria-label="{{ 'cart.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </header>

    <div class="cart-drawer__body" data-cart-drawer-body>
      {%- capture product_ids -%},{% for item in cart.items %}{{ item.product_id }},{% endfor %}{%- endcapture -%}
      <span hidden data-cart-count-source="{{ cart.item_count }}" data-cart-label-source="{{ 'header.cart_count' | t: count: cart.item_count }}" data-cart-product-ids="{{ product_ids }}"></span>
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <p class="cart-empty__title h3">{{ 'cart.empty' | t }}</p>
          <p class="muted">{{ 'cart.empty_text' | t }}</p>
          <a class="button" href="{{ routes.all_products_url }}">{{ 'cart.continue' | t }}</a>
        </div>
        {% render 'cart-recommendations', limit: 2 %}
      {%- else -%}
        <div class="cart-drawer__items">
          {% render 'cart-items' %}
        </div>
        <div class="cart-drawer__footer">
          {% render 'cart-summary' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
