{{ 'sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero-gallery.js' | asset_url }}" defer></script>

{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all']
  endif
-%}

<section class="hero hero--room" data-hero-gallery data-count="{{ section.settings.count }}">
  <div class="hero__media hero__media--room">
    <div class="hero-room" data-hero-room role="group" aria-label="{{ 'hero.gallery_label' | t }}">
      <img
        class="hero-room__bg"
        src="{{ 'hero-room.svg' | asset_url }}"
        alt=""
        width="8857"
        height="2386"
        fetchpriority="high"
      >
      <div class="hero-room__wall" data-hero-wall></div>
    </div>

    <button type="button" class="button button--secondary hero-room__shuffle" data-hero-shuffle>
      {% render 'icon', name: 'shuffle' %}
      <span>{{ 'hero.shuffle' | t }}</span>
    </button>
    <p class="visually-hidden" role="status" data-hero-status></p>
  </div>

  {%- if section.settings.heading != blank -%}
    <h1 class="visually-hidden">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- comment -%}
    Werken met een leesbare maat. Maten in cm; formaat met lijst (size_framed) indien ingevuld,
    anders het werk + 10 cm voor lijst en passe-partout.
  {%- endcomment -%}
  <script type="application/json" data-hero-works>
    [
      {%- assign first_item = true -%}
      {%- for product in source.products limit: 24 -%}
        {%- if product.available and product.featured_image -%}
          {%- assign art_text = product.metafields.artwork.size_artwork.value -%}
          {%- assign framed_text = product.metafields.artwork.size_framed.value -%}
          {%- capture art_dims -%}{%- render 'parse-size', text: art_text -%}{%- endcapture -%}
          {%- capture framed_dims -%}{%- render 'parse-size', text: framed_text -%}{%- endcapture -%}
          {%- assign art_parts = art_dims | split: ',' -%}
          {%- assign framed_parts = framed_dims | split: ',' -%}
          {%- assign art_w = art_parts[0] | times: 1.0 -%}
          {%- assign art_h = art_parts[1] | times: 1.0 -%}
          {%- assign frame_w = framed_parts[0] | times: 1.0 -%}
          {%- assign frame_h = framed_parts[1] | times: 1.0 -%}
          {%- if frame_w <= 0 or frame_h <= 0 -%}
            {%- assign frame_w = art_w | plus: 10.0 -%}
            {%- assign frame_h = art_h | plus: 10.0 -%}
          {%- endif -%}
          {%- assign frame_text = product.metafields.artwork.frame.value | downcase -%}
          {%- assign frame_style = 'black' -%}
          {%- if frame_text contains 'hout' -%}
            {%- assign frame_style = 'wood' -%}
          {%- elsif frame_text contains 'wit' -%}
            {%- assign frame_style = 'white' -%}
          {%- endif -%}
          {%- if art_w > 0 and art_h > 0 -%}
            {%- unless first_item -%},{%- endunless -%}
            {%- assign first_item = false -%}
            {
              "handle": {{ product.handle | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "img": {{ product.featured_image | image_url: width: 800 | json }},
              "alt": {{ 'product.image_alt' | t: title: product.title | json }},
              "aw": {{ art_w }},
              "ah": {{ art_h }},
              "fw": {{ frame_w }},
              "fh": {{ frame_h }},
              "style": {{ frame_style | json }}
            }
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Hero met galerijwand",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Werken voor de galerijwand",
      "info": "Alleen beschikbare werken met een ingevulde maat (metafield 'Maat werk') worden getoond, op schaal. Leeg laten voor alle werken."
    },
    { "type": "range", "id": "count", "label": "Aantal schilderijen naast elkaar", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "text",
      "id": "heading",
      "label": "Paginakop (onzichtbaar)",
      "default": "Kleur als taal",
      "info": "Wordt niet getoond, maar blijft in de pagina voor zoekmachines en schermlezers."
    }
  ],
  "presets": [{ "name": "Hero met galerijwand" }]
}
{% endschema %}
