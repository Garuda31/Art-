{{ 'sections.css' | asset_url | stylesheet_tag }}

<section class="section shipping">
  <div class="container shipping__inner">
    <h1 class="shipping__title">{{ page.title }}</h1>
    {%- for block in section.blocks -%}
      <div class="shipping__topic" data-reveal {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="h3">{{ block.settings.heading }}</h2>
        {%- endif -%}
        <div class="rte">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Verzending & retour",
  "blocks": [
    {
      "type": "topic",
      "name": "Onderwerp",
      "settings": [
        { "type": "text", "id": "heading", "label": "Kop" },
        { "type": "richtext", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [{ "name": "Verzending & retour" }]
}
{% endschema %}
