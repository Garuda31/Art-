{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign handle = settings.instagram_handle
  assign profile_url = 'https://www.instagram.com/' | append: handle
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'instagram.heading' | t
  endif
  assign tile_alt = 'instagram.alt' | t: handle: handle
-%}

<section class="section instagram">
  <div class="container">
    <div class="section-heading" data-reveal>
      <h2>{{ heading }}</h2>
      {%- if handle != blank -%}
        <a class="link-arrow" href="{{ profile_url }}" target="_blank" rel="noopener">
          {{ 'instagram.follow' | t: handle: handle }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <ul class="instagram__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign tile_link = block.settings.link | default: profile_url -%}
        <li {{ block.shopify_attributes }}>
          <a class="instagram__tile" href="{{ tile_link }}" target="_blank" rel="noopener">
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  widths: '300, 450, 600',
                  sizes: '(min-width: 900px) 15vw, 33vw',
                  loading: 'lazy',
                  alt: tile_alt
              }}
            {%- else -%}
              <span class="instagram__empty" role="img" aria-label="{{ tile_alt }}"></span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Instagram-strook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Kop", "info": "Leeg laten voor de standaardtekst." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Afbeelding",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leeg laten voor het Instagram-profiel." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Instagram-strook",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
