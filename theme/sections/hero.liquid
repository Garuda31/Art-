{{ 'sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'home.hero_button_fallback' | t
  endif
  assign button_link = section.settings.button_link
  if button_link == blank
    assign button_link = routes.all_products_url
  endif
-%}

<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image_alt,
          class: 'hero__image'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__panel">
    <div class="container">
      <div class="hero__content" data-reveal>
        {%- if section.settings.heading != blank -%}
          <h1 class="hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <a class="button" href="{{ button_link }}">{{ button_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Afbeelding", "info": "Interieurfoto met een schilderij. Aanbevolen: 2400 × 1400 px." },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst afbeelding" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Kleur als taal" },
    { "type": "textarea", "id": "text", "label": "Subtekst", "default": "Abstracte schilderijen in acryl, met de hand gemaakt. Elk werk is uniek." },
    { "type": "text", "id": "button_label", "label": "Knoptekst", "info": "Leeg laten voor 'Bekijk de collectie'." },
    { "type": "url", "id": "button_link", "label": "Knoplink", "info": "Leeg laten voor alle werken." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
