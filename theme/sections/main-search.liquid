{{ 'collection.css' | asset_url | stylesheet_tag }}
{{ 'sections.css' | asset_url | stylesheet_tag }}

<section class="section search">
  <div class="container">
    <h1 class="search__title">{{ 'search.title' | t }}</h1>

    <form class="search__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="search-input">{{ 'search.title' | t }}</label>
      <input
        class="field"
        type="search"
        id="search-input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <p class="search__count small muted" role="status">
            {{- 'search.results_for' | t: count: search.results_count, terms: search.terms -}}
          </p>
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li class="product-grid__item">
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item, eager: forloop.first %}
                {%- else -%}
                  <article class="search__result">
                    <p class="eyebrow">
                      {%- if item.object_type == 'article' -%}{{ 'search.type_article' | t }}{%- else -%}{{ 'search.type_page' | t }}{%- endif -%}
                    </p>
                    <h2 class="h3"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="search__empty">
            <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
            <a class="button button--secondary" href="{{ routes.all_products_url }}">{{ 'search.browse' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zoeken",
  "settings": []
}
{% endschema %}
