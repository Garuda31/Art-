{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer></script>

<div class="collection section--tight">
  <div class="container">
    <header class="collection__header" data-reveal>
      <h1 class="collection__title">{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection__intro rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <form
        class="collection__toolbar"
        method="get"
        action="{{ collection.url }}"
        aria-label="{{ 'collection.filters_label' | t }}"
        data-filter-form
      >
        <div class="collection__toolbar-row">
          {%- if section.settings.show_filters and collection.filters.size > 0 -%}
            <details class="filters-panel" data-filters-panel>
              <summary class="button button--secondary">{{ 'collection.filter' | t }}</summary>
              <div class="filters-panel__body">
                {%- for filter in collection.filters -%}
                  <fieldset class="filter">
                    <legend class="filter__legend">{{ filter.label }}</legend>
                    {%- if filter.type == 'price_range' -%}
                      <div class="filter__price">
                        <label>
                          <span class="small">{{ 'collection.price_from' | t }}</span>
                          <input
                            class="field"
                            type="number"
                            inputmode="numeric"
                            min="0"
                            name="{{ filter.min_value.param_name }}"
                            placeholder="0"
                            {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 | round }}"{% endif %}
                          >
                        </label>
                        <label>
                          <span class="small">{{ 'collection.price_to' | t }}</span>
                          <input
                            class="field"
                            type="number"
                            inputmode="numeric"
                            min="0"
                            name="{{ filter.max_value.param_name }}"
                            placeholder="{{ filter.range_max | divided_by: 100.0 | round }}"
                            {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 | round }}"{% endif %}
                          >
                        </label>
                      </div>
                    {%- else -%}
                      <ul class="filter__list">
                        {%- for value in filter.values -%}
                          {%- assign unavailable = false -%}
                          {%- if value.count == 0 and value.active == false -%}
                            {%- assign unavailable = true -%}
                          {%- endif -%}
                          <li>
                            <label class="filter__option{% if unavailable %} is-disabled{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if unavailable %}disabled{% endif %}
                              >
                              <span>{{ value.label }} <span class="muted">({{ value.count }})</span></span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}
                <button type="submit" class="button" data-filter-submit>{{ 'collection.apply' | t }}</button>
              </div>
            </details>
          {%- endif -%}

          <p class="collection__count small muted" role="status">
            {{- 'collection.results_count' | t: count: paginate.items -}}
          </p>

          {%- if section.settings.show_sort and collection.sort_options.size > 0 -%}
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <div class="collection__sort">
              <label class="small muted" for="sort-by">{{ 'collection.sort_by' | t }}</label>
              <select class="field field--select" id="sort-by" name="sort_by" data-filter-auto>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
        </div>

        {%- assign has_active = false -%}
        {%- for filter in collection.filters -%}
          {%- if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value -%}
            {%- assign has_active = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_active -%}
          <ul class="active-filters" aria-label="{{ 'collection.active_filters' | t }}">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value or filter.max_value.value -%}
                  <li>
                    <a class="chip" href="{{ filter.url_to_remove }}" aria-label="{{ 'collection.remove_filter' | t: label: filter.label }}">
                      {{ filter.label }}
                      {% render 'icon', name: 'close' %}
                    </a>
                  </li>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <li>
                    <a class="chip" href="{{ value.url_to_remove }}" aria-label="{{ 'collection.remove_filter' | t: label: value.label }}">
                      {{ value.label }}
                      {% render 'icon', name: 'close' %}
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
            <li><a class="chip chip--clear" href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a></li>
          </ul>
        {%- endif -%}
      </form>

      {%- if collection.products.size == 0 -%}
        <p class="collection__empty">
          {{ 'collection.no_results' | t }}
          <a href="{{ collection.url }}">{{ 'collection.clear_all' | t }}</a>
        </p>
      {%- else -%}
        <ul class="product-grid" role="list" aria-label="{{ 'collection.products_label' | t }}">
          {%- comment -%} Beschikbare werken eerst, verkochte werken daarna. {%- endcomment -%}
          {%- for product in collection.products -%}
            {%- if product.available -%}
              <li class="product-grid__item" data-reveal>
                {% render 'product-card', product: product, eager: forloop.first, archive: section.settings.archive_mode %}
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- for product in collection.products -%}
            {%- unless product.available -%}
              <li class="product-grid__item" data-reveal>
                {% render 'product-card', product: product, archive: section.settings.archive_mode %}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collectie",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Intro van de collectie tonen", "default": true },
    { "type": "checkbox", "id": "show_filters", "label": "Filters tonen", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Sortering tonen", "default": true },
    {
      "type": "checkbox",
      "id": "archive_mode",
      "label": "Archiefmodus",
      "info": "Toont bij elk werk het label 'Verkocht' of 'Niet te koop' en nooit een prijs.",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Werken per pagina",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 48,
      "info": "Verkochte werken staan onderaan binnen een pagina. Een hoog aantal houdt ze onderaan de hele collectie."
    }
  ]
}
{% endschema %}
